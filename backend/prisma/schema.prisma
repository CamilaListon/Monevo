generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  avatarPath     String?
  avatarMimeType String?
  avatarData     String?  @db.Text
  bills          Bill[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Bill {
  id                 String    @id @default(cuid())
  title              String
  category           String
  amount             Decimal   @db.Decimal(12, 2)
  dueDate            DateTime  @db.Date
  paidAt             DateTime?
  notes              String?
  recurring          Boolean   @default(false)
  recurrenceSourceId String?
  recurrenceSkipped  Boolean   @default(false)
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceSource   Bill?     @relation("BillOccurrences", fields: [recurrenceSourceId], references: [id], onDelete: Cascade)
  recurrences        Bill[]    @relation("BillOccurrences")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([recurrenceSourceId, dueDate])
  @@index([userId, dueDate])
  @@index([userId, paidAt])
}
